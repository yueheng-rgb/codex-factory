{
  "name": "@codex-app-factory/cli",
  "version": "5.0.0-preview.1",
  "private": true,
  "description": "Local-first Codex Factory control plane for verified context, native multi-agent orchestration, and opt-in search.",
  "type": "module",
  "bin": {
    "factoryctl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "domain-skills",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "cli": "tsx src/cli.ts",
    "demo:tour": "tsx scripts/demo-tour.ts",
    "demo:repair": "tsx scripts/demo-repair.ts",
    "demo:clarify": "tsx scripts/demo-clarification.ts",
    "demo:teach": "tsx scripts/demo-teaching.ts",
    "demo:probe": "tsx scripts/demo-probe.ts",
    "eval:prepare": "tsx scripts/live-eval.ts prepare",
    "eval:forecast": "tsx scripts/forecast-effects.ts",
    "eval:lessons": "tsx scripts/eval-lesson-selection.ts",
    "eval:transfer": "tsx scripts/eval-transfer-boundary.ts prepare",
    "eval:report": "tsx scripts/live-eval.ts summarize",
    "eval:typecheck": "tsc -p tsconfig.evals.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
