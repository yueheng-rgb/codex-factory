      "expected_invariants": ["admin_required_for_admin_routes","role_permission_must_be_enforced","ordinary_admin_cannot_escalate_role","audit_log_required_for_sensitive_actions","pagination_limit_enforced"],
      "runnable_or_design_only": "runnable",
      "human_audit_required": false,
      "external_engines_expected": ["semgrep"],
      "success_criteria": "RBAC enforced, role escalation blocked, audit logs created for sensitive actions"
    },
    {
      "benchmark_id": "ADMIN-B3",
      "description": "Full admin with batch ops, export, status workflows — product management admin",
      "expected_surfaces": ["admin-web","api-service","database","docs-release"],
      "expected_risk_level": "CRITICAL",
      "expected_invariants": ["admin_required_for_admin_routes","role_permission_must_be_enforced","ordinary_admin_cannot_escalate_role","destructive_action_requires_confirmation","batch_operation_must_be_scoped","export_requires_permission","status_transition_allowed","audit_log_required_for_sensitive_actions","pagination_limit_enforced"],
      "runnable_or_design_only": "design_only",
      "human_audit_required": true,
