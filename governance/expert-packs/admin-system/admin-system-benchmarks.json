      "expected_surfaces": ["admin-web","api-service","database"],
      "expected_risk_level": "MEDIUM",
      "expected_invariants": ["admin_required_for_admin_routes","pagination_limit_enforced"],
      "runnable_or_design_only": "runnable",
      "human_audit_required": false,
      "external_engines_expected": ["semgrep"],
      "success_criteria": "Admin CRUD works, routes protected, pagination enforced, no permission escalation possible"
    },
    {
      "benchmark_id": "ADMIN-B2",
      "description": "Admin system with role-based access control and audit log — multi-role user admin",
      "expected_surfaces": ["admin-web","api-service","database","docs-release"],
