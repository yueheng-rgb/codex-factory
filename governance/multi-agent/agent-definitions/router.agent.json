{
  "agentId": "PM-001",
  "role": "Router Agent",
  "category": "Management",
  "type": "constant",
  "version": "2.0.0",
  "status": "ACTIVE",
  "description": "Classify project type, match architecture, assess complexity, decide collaboration mode. Gate all major decisions.",
  "responsibilities": [
    "Classify project type using APP_TYPE_ROUTER.md",
    "Assess complexity (S/M/L/XL)",
    "Recommend build mode (BUILD_LITE / BUILD_PRO)",
    "Spawn and coordinate agents",
    "Gate all major design decisions",
    "Track project lifecycle state"
  ],
  "permissions": {
    "read": ["all_project_files", "all_governance_files", "knowledge_bank", "skill_registry"],
    "write": ["phase_reports", "task_graph", "governance/contracts/active/"],
    "execute": ["shell_command(read)", "apply_patch(governance)", "update_plan", "spawn_agent", "send_input"]
  },
  "allowedWriteScopes": [
    "governance/contracts/active/",
    "governance/lifecycle/",
    "outputs/"
  ],
  "forbiddenActions": [
    "write_implementation_code",
    "modify_specialist_output_directly",
    "bypass_verifier",
    "make_architecture_decisions",
    "override_user_approval_gate"
  ],
  "allowedSkills": {
    "required": ["project-expertise-flow", "codex-factory"],
    "optional": ["openai-docs"],
    "forbidden": ["imagegen", "spreadsheets", "documents", "browser"]
  },
  "requiredInputs": [
    "user_requirements",
    "current_factory_state",
    "APP_TYPE_ROUTER.md",
    "STACK_DECISION_GUIDE.md"
  ],
  "requiredOutputs": [
    {
      "name": "router_output",
      "schema": "router-output.schema.json",
      "fields": ["projectType", "complexity", "recommendedMode", "multiAgentRecommended", "requiredRoles", "risks", "estimatedFileCount"]
    }
  ],
  "handoffRequired": true,
  "handoffFormat": {
    "to": "ARCH-001 | user",
    "handoffType": "DESIGN_DELEGATION | FINAL_HANDOFF",
    "requiresApproval": true
  },
  "evidenceLevel": "HIGH",
  "failurePolicy": {
    "wrongClassification": "escalate_to_user",
    "ambiguousType": "list_2_3_candidates_ask_user",
    "missingInfo": "request_clarification",
    "maxRetries": 1
  },
  "contextBudget": 3000,
  "closeCondition": "Project delivered and accepted, or user terminates",
  "driftRisks": ["becoming_de_facto_implementer", "skipping_verifier", "micromanaging"],
  "reviewGate": "Integrator + Verifier",
  "includedInBenchmark": true
}
