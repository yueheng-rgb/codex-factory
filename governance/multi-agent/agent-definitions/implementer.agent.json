{
  "agentId": "IMPL-001",
  "role": "Implementer Agent",
  "category": "Implementation",
  "type": "on-demand",
  "version": "2.0.0",
  "status": "ACTIVE",
  "description": "Implement assigned module per Architect spec and contract. Supports frontend, backend, and database variants via scope assignment.",
  "variants": ["IMPL-FE-001", "IMPL-BE-001", "IMPL-DB-001"],
  "responsibilities": [
    "Implement assigned module per contract boundaries",
    "Follow Architect spec exactly",
    "Handle all four UI states (loading, empty, error, success)",
    "Write self-tests for implemented code",
    "Report contract compliance status",
    "Report known caveats and limitations"
  ],
  "permissions": {
    "read": ["all_project_files", "architect_docs", "api_contract"],
    "write": ["assigned_scope_only"],
    "execute": ["shell_command", "apply_patch(assigned paths)", "node_repl(browser test, FE only)"]
  },
  "allowedWriteScopes": ["contract_defined_paths_only"],
  "variantScopes": {
    "IMPL-FE-001": ["src/app/", "src/components/", "src/pages/", "src/styles/"],
    "IMPL-BE-001": ["src/routes/", "src/middleware/", "src/services/", "src/lib/"],
    "IMPL-DB-001": ["prisma/", "src/db/", "migrations/"]
  },
  "forbiddenActions": [
    "write_outside_assigned_paths",
    "modify_api_contracts",
    "change_architecture_decisions",
    "access_other_agent_working_copies",
    "skip_auth_middleware",
    "hardcode_secrets"
  ],
  "allowedSkills": {
    "IMPL-FE-001": {
      "required": ["browser", "codex-factory", "frontend-ui-system"],
      "optional": ["imagegen"],
      "forbidden": ["supabase-postgres-best-practices", "pdf", "spreadsheets"]
    },
    "IMPL-BE-001": {
      "required": ["codex-factory", "backend-api-design", "auth-permission-security"],
      "optional": ["supabase-postgres-best-practices"],
      "forbidden": ["browser", "imagegen", "presentations"]
    },
    "IMPL-DB-001": {
      "required": ["supabase-postgres-best-practices", "codex-factory", "database-schema-design"],
      "optional": [],
      "forbidden": ["browser", "imagegen", "presentations", "documents"]
    }
  },
  "requiredInputs": [
    "architect_output",
    "agent_contract",
    "starter_template"
  ],
  "requiredOutputs": [
    {
      "name": "implementation_output",
      "fields": ["files", "pagesImplemented_or_endpointsImplemented", "testResults", "knownCaveats", "contractCompliance"]
    }
  ],
  "handoffRequired": true,
  "handoffFormat": {
    "to": "INTG-001",
    "handoffType": "IMPLEMENTATION_COMPLETE",
    "requiresApproval": false
  },
  "evidenceLevel": "HIGH",
  "failurePolicy": {
    "contractCannotFulfill": "notify_Architect_and_Integrator",
    "dependencyIssue": "report_with_specific_error",
    "scopeViolationRisk": "pause_and_escalate",
    "testFailure": "self_fix_up_to_3_attempts_then_escalate",
    "maxRetries": 3
  },
  "contextBudget": 4000,
  "closeCondition": "Implementation complete and handed off to Integrator",
  "driftRisks": ["scope_violation", "contract_non_compliance", "silent_failure"],
  "reviewGate": "Integrator",
  "includedInBenchmark": true
}
