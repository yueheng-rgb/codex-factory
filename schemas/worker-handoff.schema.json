{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker Handoff",
  "description": "Codex Factory V4.2 — Worker-to-Integrator handoff protocol",
  "type": "object",
  "required": ["worker_id","task_ids","status","timestamp","next_agent"],
  "properties": {
    "worker_id": {"type":"string","description":"Worker producing this handoff"},
    "task_ids": {"type":"array","items":{"type":"string"},"description":"Task IDs covered by this handoff"},
    "status": {"type":"string","enum":["PENDING","COMPLETED","PARTIAL","BLOCKED","FAILED"],"description":"PENDING is template-only; only COMPLETED can pass task validation"},
    "files_changed": {"type":"array","items":{"type":"string"},"description":"Project-relative physical files modified by this worker"},
    "artifacts_produced": {"type":"array","items":{"type":"string"},"description":"Non-empty physical artifact paths relative to runs/<run-id>/artifacts"},
    "tests_run": {"type":"integer","description":"Number of tests executed (if applicable)"},
    "tests_passed": {"type":"integer","description":"Number of tests passed"},
    "tests_failed": {"type":"integer","description":"Number of tests failed"},
    "validation_result": {"type":"string","enum":["PASS","FAIL","SKIPPED","PENDING"],"description":"Worker self-validation result"},
    "blockers": {"type":"array","items":{"type":"string"},"description":"Issues preventing completion"},
    "assumptions": {"type":"array","items":{"type":"string"},"description":"Assumptions made during execution"},
    "handoff_notes": {"type":"string","description":"Free-form notes for the next agent"},
    "next_agent": {"type":"string","description":"Intended recipient (integrator or specific worker)"},
    "timestamp": {"type":"string","format":"date-time","description":"When this handoff was created"}
  }
}
