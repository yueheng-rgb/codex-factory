{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Server Manifest",
  "description": "Manifest for MCP server tools registered in Factory",
  "type": "object",
  "required": ["serverId", "name", "transport", "riskLevel"],
  "properties": {
    "serverId": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "transport": { "type": "string", "enum": ["stdio", "sse", "streamable-http"] },
    "command": { "type": "string", "description": "Launch command for stdio transport" },
    "args": { "type": "array", "items": { "type": "string" } },
    "env": { "type": "object", "description": "Environment variables (must not contain secrets here)" },
    "url": { "type": "string", "description": "URL for SSE/HTTP transport" },
    "requiresApiKey": { "type": "boolean", "default": false },
    "apiKeyEnvVar": { "type": "string", "description": "Env var name for API key (value must NOT be stored here)" },
    "networkAccess": { "type": "boolean", "default": false },
    "fileReadAccess": { "type": "boolean", "default": false },
    "fileWriteAccess": { "type": "boolean", "default": false },
    "externalServiceAccess": { "type": "boolean", "default": false },
    "cloudRequired": { "type": "boolean", "default": false },
    "sandboxRequired": { "type": "boolean", "default": false },
    "humanConfirmationRequired": { "type": "boolean", "default": false },
    "riskLevel": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] },
    "allowedAgents": { "type": "array", "items": { "type": "string" } },
    "allowedProjectTypes": { "type": "array", "items": { "type": "string" } },
    "allowedPhases": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "object", "properties": { "name": {"type":"string"}, "description": {"type":"string"}, "riskNote": {"type":"string"} } } },
    "resources": { "type": "array", "items": { "type": "object", "properties": { "uri": {"type":"string"}, "description": {"type":"string"} } } },
    "hash": { "type": "string", "description": "SHA256 of manifest for integrity" },
    "status": { "type": "string", "enum": ["candidate", "monitor", "sandboxReady", "allowedWithControls", "rejected", "quarantine", "deprecated"] }
  }
}
