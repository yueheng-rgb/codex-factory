{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-factory.local/schemas/deployment-manifest.schema.json",
  "title": "Deployment Manifest",
  "description": "Standardized deployment documentation for Codex Factory projects.",
  "type": "object",
  "required": ["project_name", "deployment_targets", "env_vars", "ports", "health_check_path"],
  "properties": {
    "project_name": { "type": "string" },
    "version": { "type": "string" },
    "repository": { "type": "string" },
    "deployment_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "enum": ["local","docker","vps","vercel","railway","fly.io","custom"] },
          "start_command": { "type": "string" },
          "build_command": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "secret": { "type": "boolean" },
          "default": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": { "type": "object", "properties": { "port": { "type": "integer" }, "purpose": { "type": "string" } } }
    },
    "health_check_path": { "type": "string" },
    "database": {
      "type": "object",
      "properties": { "type": { "type": "string" }, "migration_command": { "type": "string" }, "seed_command": { "type": "string" } }
    },
    "rollback_notes": { "type": "string" },
    "known_non_claims": { "type": "array", "items": { "type": "string" } },
    "known_risks": { "type": "array", "items": { "type": "string" } }
  }
}
