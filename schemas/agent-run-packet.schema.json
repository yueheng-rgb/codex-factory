{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Run Packet",
  "description": "Consumable packet for real Codex agent sessions, generated by Factory bridge",
  "type": "object",
  "required": ["packetId", "packetType", "projectId", "phaseId", "agentId", "loadedSkillRefs"],
  "properties": {
    "packetId": { "type": "string", "description": "Unique packet identifier" },
    "packetType": { "type": "string", "enum": ["agent-run-packet", "skill-context-packet", "verification-command-packet"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string" },
    "phaseId": { "type": "string" },
    "agentId": { "type": "string" },
    "projectType": { "type": "string" },
    "taskDescription": { "type": "string" },
    "loadedSkillRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillId", "trustLevel", "status"],
        "properties": {
          "skillId": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "trustLevel": { "type": "string", "enum": ["VERIFIED", "TRUSTED", "AVAILABLE", "CAUTION", "UNTRUSTED", "QUARANTINE"] },
          "status": { "type": "string", "enum": ["candidate", "adapted", "verified", "auditPassed", "factoryRuntimeVerified", "realAgentVerified", "multiProjectVerified", "quarantine", "deprecated"] },
          "summary": { "type": "string", "maxLength": 500 },
          "allowedTools": { "type": "array", "items": { "type": "string" } },
          "forbiddenActions": { "type": "array", "items": { "type": "string" } },
          "triggerConditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "allowedCapabilities": { "type": "array", "items": { "type": "string" } },
    "forbiddenActions": { "type": "array", "items": { "type": "string" } },
    "requiredOutputs": { "type": "array", "items": { "type": "string" } },
    "handoffRequired": { "type": "boolean" },
    "trustStatusNote": { "type": "string" }
  }
}
