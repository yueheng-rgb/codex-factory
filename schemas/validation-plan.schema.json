{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Plan",
  "type": "object",
  "required": ["per_task_validation","global_gates"],
  "properties": {
    "per_task_validation": { "type": "array", "items": {
      "type": "object", "required": ["task_id","methods"],
      "properties": {
        "task_id": {"type":"string"},
        "methods": {"type":"array","items":{"type":"string","enum":["test","artifact","review","static_check","manual_instruction"]}},
        "required_evidence": {"type":"array","items":{"type":"string"}},
        "blocking": {"type":"boolean","default":true}
      }
    }},
    "global_gates": { "type": "array", "items": {
      "type": "object", "required": ["gate","status"],
      "properties": { "gate": {"type":"string"}, "status": {"type":"string","enum":["required","optional","skipped"]}, "condition": {"type":"string"} }
    }},
    "non_claims": { "type":"array","items":{"type":"string"}, "default": ["No artifact = no PASS","Every task must have at least one validation method"] }
  }
}
