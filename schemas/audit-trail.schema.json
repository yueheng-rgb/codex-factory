{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Trail Entry",
  "description": "Immutable audit ledger entry with hash chain linking",
  "version": "1.0.0",
  "type": "object",
  "required": ["entry_id","timestamp","event_type"],
  "properties": {
    "entry_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": { "type": "string", "enum": ["REGRESSION_RUN","ENGINE_RUN","HANDOFF","REPORT_GENERATED","GATE_DECISION","RELEASE_EVENT"] },
    "target": { "type": "string" },
    "command": { "type": "string" },
    "exit_code": { "type": "integer" },
    "stdout_path": { "type": "string" },
    "stderr_path": { "type": "string" },
    "artifact_path": { "type": "string" },
    "result_summary": { "type": "string" },
    "previous_hash": { "type": "string", "description": "Hash of previous entry for chain integrity" },
    "current_hash": { "type": "string" },
    "evidence_binding": {
      "type": "object",
      "properties": {
        "evidence_id": { "type": "string" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
