{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-detection-result.schema.json",
  "title": "Gate Detection Result",
  "description": "Automated detection result for a single gate check.",
  "type": "object",
  "required": ["gateName", "status", "detectedAt"],
  "properties": {
    "gateName": { "type": "string", "enum": ["tests_present", "invariant_spec_present", "reviewer_present", "human_audit_present", "coverage_evidence_present", "decomposition_plan_present"] },
    "status": { "type": "string", "enum": ["SATISFIED", "MISSING", "PARTIAL", "NOT_APPLICABLE"] },
    "evidenceFiles": { "type": "array", "items": { "type": "string" } },
    "evidenceCommands": { "type": "array", "items": { "type": "string" } },
    "evidenceSummary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "blockingReason": { "type": "string" },
    "detectedAt": { "type": "string", "format": "date-time" }
  }
}
