{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-surface-plan.schema.json",
  "title": "Project Surface Plan",
  "description": "Describes a project as a composition of independently-buildable surfaces with their dependencies, starters, risks, and integration points.",
  "type": "object",
  "required": ["planId", "projectName", "projectType", "surfaces", "integrationPlan", "createdAt"],
  "properties": {
    "planId": { "type": "string", "description": "Unique plan identifier" },
    "projectName": { "type": "string" },
    "projectType": {
      "type": "string",
      "enum": ["single-surface", "multi-surface", "combo"],
      "description": "single-surface (1 surface), multi-surface (2+ related surfaces), combo (cross-type)"
    },
    "primaryProjectType": {
      "type": "string",
      "description": "Primary APP_TYPE_ROUTER classification if applicable",
      "enum": ["fullstack-admin", "content-site", "saas-tool", "api-service", "miniapp", "mobile-app", "threejs-interactive", "combo"]
    },
    "overallRiskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "complexityClass": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"]
    },
    "humanAuditRequired": { "type": "boolean" },
    "humanAuditReason": { "type": "string" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "integrationPlan": {
      "type": "object",
      "required": ["sharedSchemas", "apiContracts", "buildOrder"],
      "properties": {
        "sharedSchemas": { "type": "array", "items": { "type": "string" } },
        "apiContracts": { "type": "array", "items": { "type": "string" } },
        "buildOrder": { "type": "array", "items": { "type": "string" } },
        "sharedPackages": { "type": "array", "items": { "type": "string" } },
        "deploymentNotes": { "type": "string" }
      }
    },
    "firstSlice": { "type": "string", "description": "Which surface to build first" },
    "firstSliceReason": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["surfaceId", "surfaceType", "purpose", "recommendedStarter"],
      "properties": {
        "surfaceId": { "type": "string" },
        "surfaceType": {
          "type": "string",
          "enum": ["api-service", "admin-web", "public-web", "frontend-web", "miniapp", "mobile-app", "threejs-interactive", "background-worker", "database", "docs-release"]
        },
        "purpose": { "type": "string" },
        "recommendedStarter": { "type": "string" },
        "fallbackStarter": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "providesTo": { "type": "array", "items": { "type": "string" } },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "requiredTests": { "type": "array", "items": { "type": "string" } },
        "integrationPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "protocol"],
            "properties": {
              "target": { "type": "string" },
              "protocol": { "type": "string", "enum": ["REST", "GraphQL", "WebSocket", "gRPC", "file", "shared-db", "event"] },
              "description": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
