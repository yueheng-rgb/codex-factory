{
  "version": "6A.1",
  "description": "Codex App Factory Phase 6A Harness — minimal multi-agent orchestration with independent verification",
  "roles": {
    "orchestrator": {
      "maxAgents": 1,
      "description": "Master control & task assignment"
    },
    "spec-agent": {
      "maxAgents": 1,
      "description": "Requirements & acceptance criteria"
    },
    "builder-agent": {
      "maxAgents": 1,
      "description": "Feature implementation"
    },
    "test-agent": {
      "maxAgents": 1,
      "description": "Independent verification"
    },
    "release-agent": {
      "maxAgents": 1,
      "description": "Final packaging & round-trip validation"
    }
  },
  "stateFiles": {
    "tasks": "runtime/TASKS.json",
    "acceptance": "runtime/ACCEPTANCE.json",
    "ownership": "runtime/OWNERSHIP.json",
    "runState": "runtime/RUN_STATE.jsonl",
    "releaseManifest": "runtime/RELEASE_MANIFEST.json"
  },
  "completionGate": {
    "description": "Only Validator (validate-state.ps1) can declare PASS. Agents can only submit candidate_complete.",
    "passCriteria": [
      "All required acceptance items pass",
      "All tasks verified",
      "No unclosed validation_started events",
      "No builder self-verification",
      "All evidence files exist",
      "ZIP round-trip passes",
      "No manual remediation recorded"
    ]
  }
}