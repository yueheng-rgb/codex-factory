{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-registry.schema.json",
  "title": "Skill Registry Entry",
  "description": "Schema for a skill entry in the Codex Factory Skill Registry",
  "type": "object",
  "required": ["skillId", "name", "version", "trustLevel", "source", "category", "status", "createdAt"],
  "properties": {
    "skillId": {
      "type": "string",
      "pattern": "^SKILL-[a-f0-9-]+$",
      "description": "Unique skill identifier"
    },
    "name": { "type": "string", "description": "Machine-readable skill name, e.g. nextjs-auth-patterns" },
    "displayName": { "type": "string", "description": "Human-readable name" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semantic version" },
    "trustLevel": {
      "type": "string",
      "enum": ["VERIFIED", "TRUSTED", "AVAILABLE", "UNVERIFIED", "BLOCKED"],
      "description": "Trust tier assigned after audit"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["internal", "imported", "adapted", "untrusted_candidate"] },
        "originUrl": { "type": "string" },
        "originRepo": { "type": "string" },
        "importedAt": { "type": "string", "format": "date-time" },
        "importedBy": { "type": "string", "description": "Agent ID" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["auth", "database", "frontend", "backend", "miniapp", "mobile", "security", "testing", "devops", "architecture", "governance", "ui", "api"]
    },
    "applicableProjectTypes": {
      "type": "array",
      "items": { "type": "string", "enum": ["content-site", "fullstack-admin", "saas-tool", "api-service", "miniapp", "mobile-app", "threejs-interactive"] }
    },
    "requiredByRoles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Agent IDs that require this skill"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other skill IDs this skill depends on"
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skill IDs that conflict with this skill"
    },
    "filePath": { "type": "string", "description": "Path relative to knowledge-bank/skills/" },
    "checksum": { "type": "string", "description": "SHA-256 of skill directory contents" },
    "checksPassed": {
      "type": "array",
      "items": { "type": "string", "enum": ["source_check", "content_audit", "script_audit", "network_audit", "scope_audit", "conflict_test", "sandbox_test"] }
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "DEPRECATED", "SUPERSEDED", "DRAFT"],
      "default": "DRAFT"
    },
    "deprecationNotice": { "type": "string" },
    "supersededBy": { "type": "string", "description": "Skill ID of replacement" },
    "createdAt": { "type": "string", "format": "date-time" },
    "lastAuditedAt": { "type": "string", "format": "date-time" },
    "auditedBy": { "type": "string" },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "changes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
