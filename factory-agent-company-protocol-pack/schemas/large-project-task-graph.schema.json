{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-app-factory/schemas/large-project-task-graph.schema.json",
  "title": "Large Project Task Graph",
  "description": "Defines a task graph for a large multi-agent factory project phase.",
  "type": "object",
  "required": ["graphId", "phaseId", "projectId", "tasks", "maxParallelAgents"],
  "properties": {
    "graphId": { "type": "string", "minLength": 1 },
    "phaseId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "maxParallelAgents": { "type": "integer", "minimum": 1, "maximum": 8 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["taskId", "taskTitle", "roleNeeded", "expectedOutputs", "status"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "taskTitle": { "type": "string", "minLength": 1 },
          "module": { "type": "string" },
          "roleNeeded": { "type": "string", "enum": ["Orchestrator","Architect","Builder","Integration Lead","Reviewer","Verifier","Integrity Checker"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "expectedOutputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredCapsule": { "type": "boolean" },
          "integrationCheckpoint": { "type": "string" },
          "riskLevel": { "type": "string", "enum": ["low","medium","high","critical"] },
          "parallelizable": { "type": "boolean" },
          "ownerAgentId": { "type": "string" },
          "status": { "type": "string", "enum": ["pending","ready","assigned","in_progress","blocked","completed","failed"] }
        }
      }
    }
  }
}
