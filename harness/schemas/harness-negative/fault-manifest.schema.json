{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fault Manifest Schema",
  "description": "Defines required fields for a negative-control fault manifest",
  "type": "object",
  "required": ["negativeId", "parentRunId", "targetLayer", "targetScenario", "expectedClassification", "injectedFaultDescription", "changedFiles", "injectionMethod", "createdAt", "createdBy", "noNewSpawnAgent"],
  "properties": {
    "negativeId": { "type": "string", "description": "Unique negative control identifier" },
    "parentRunId": { "type": "string", "description": "Parent positive run ID this negative derives from" },
    "targetLayer": { "type": "string", "description": "Acceptance layer being tested (e.g., TenantIsolationAcceptance)" },
    "targetScenario": { "type": "string", "description": "Scenario ID expected to fail (e.g., S-203)" },
    "expectedClassification": { "type": "string", "enum": ["FAIL_TARGET_GATE", "FAIL_MISSING_EVIDENCE", "FAIL_CLOSED_EVIDENCE_MUTATION", "FAIL_INTEGRATION_UNRECORDED_PATCH", "FAIL_CONTRACT_DRIFT", "FAIL_HARNESS_NOISE", "FAIL_VERIFIER_TAMPER"] },
    "injectedFaultDescription": { "type": "string", "description": "Human-readable description of the injected fault" },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "beforeSha256", "afterSha256", "operation"],
        "properties": {
          "path": { "type": "string" },
          "beforeSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "afterSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "operation": { "type": "string", "enum": ["modify", "add", "delete"] }
        }
      }
    },
    "injectionMethod": { "type": "string", "description": "How the fault was injected (e.g., text-replace, function-body-replace)" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "description": "Agent or script that created this manifest" },
    "noNewSpawnAgent": { "type": "boolean", "description": "Confirms no new spawn_agent was used" },
    "notes": { "type": "string", "description": "Optional additional notes" }
  }
}
